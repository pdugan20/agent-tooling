{
  "name": "agent-tooling",
  "version": "0.8.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "description": "Portable development tooling for a shared Codex and Claude configuration.",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "catalog": "npm run catalog:generate && vite --config catalog/vite.config.ts",
    "catalog:build": "npm run catalog:generate && npm run catalog:typecheck && vite build --config catalog/vite.config.ts",
    "catalog:check": "python3 scripts/generate_catalog.py --check",
    "catalog:generate": "python3 scripts/generate_catalog.py",
    "catalog:snapshot": "python3 scripts/generate_catalog.py --snapshot-runtime",
    "catalog:typecheck": "tsc -p catalog/tsconfig.app.json --noEmit && tsc -p catalog/tsconfig.node.json --noEmit",
    "format": "prettier --write \"**/*.{css,html,js,json,ts,tsx,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{css,html,js,json,ts,tsx,yaml,yml}\"",
    "lint:claude": "claudelint check-all --strict --no-cache --format compact && claudelint validate-skills --path .agents/skills --preset strict --warnings-as-errors",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore node_modules --ignore .agents/skills --ignore .claude/skills --ignore .claudelint-cache",
    "mcp:check": "python3 scripts/check_mcp_auth.py",
    "plugins:refresh:claude": "bash scripts/refresh-claude-plugins.sh",
    "plugins:refresh:codex": "bash scripts/refresh-codex-plugins.sh",
    "setup": "bash scripts/setup-new-machine.sh",
    "setup:check": "bash scripts/verify-setup.sh",
    "skills:update": "npx skills update -p -y",
    "superpowers:check": "python3 scripts/check_superpowers_update.py --check",
    "test": "python3 -m unittest discover -s scripts -p 'test_*.py' -v && node --test scripts/test_skill_freshness.mjs",
    "verify": "bash scripts/verify-repo.sh",
    "skills:check": "node scripts/check_skill_freshness.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "claude-code-lint": "0.7.1",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.5.2",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  }
}
